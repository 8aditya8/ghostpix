{
  "name": "ghostpix",
  "version": "1.0.0",
  "description": "Privacy-first image metadata, EXIF, GPS, and C2PA AI tag remover — works 100% locally in browser or terminal.",
  "type": "module",
  "bin": {
    "ghostpix": "./bin/ghostpix.js"
  },
  "exports": {
    ".": "./ghostpix-node.js",
    "./browser": "./ghostpix.js"
  },
  "files": [
    "assets/",
    "bin/",
    "icon.svg",
    "index.html",
    "control-center.html",
    "README.md",
    "ghostpix.js",
    "ghostpix-node.js"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "cli",
    "exif",
    "image",
    "metadata",
    "privacy",
    "c2pa",
    "ai-detection",
    "ghostpix",
    "sanitizer"
  ],
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
